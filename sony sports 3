      var $overlay = document.getElementById("overlay");
      var $loadMsg = document.getElementById("loadMsg");
      var $status  = document.getElementById("status");
      var $list    = document.getElementById("channel-list");
      var $grid    = document.getElementById("ch-grid");
      var $pc      = document.getElementById("pc");
      var $vid     = document.getElementById("v");
      var $search  = document.getElementById("channelSearch");
      var _stTmr   = null;
      var _allChannels = [];

      function getTier(){
        var mem   = navigator.deviceMemory || 4;
        var cores = navigator.hardwareConcurrency || 4;
        var mob   = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
        var conn  = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var net   = conn ? (conn.effectiveType || "4g") : "4g";
        if(!mob) return "high";
        if(mem <= 1.5 || cores <= 2 || net === "slow-2g" || net === "2g") return "low";
        if(mem <= 3   || cores <= 4) return "mid";
        return "high";
      }

      var TIER = getTier();
      var PROF = {
        low:  {buf:4,  reBuf:1.5, behind:10, maxH:480,  maxBw:1000000, bwEst:400000 },
        mid:  {buf:7,  reBuf:1.5, behind:20, maxH:720,  maxBw:3000000, bwEst:1000000},
        high: {buf:10, reBuf:1.5, behind:25, maxH:1080, maxBw:0,       bwEst:2000000}
      }[TIER];

      var FITS       = ["contain","fill","cover"];
      var FIT_LABELS = {contain:"Fit", fill:"Fill", cover:"Zoom"};

      function toast(msg, type, dur){
        $status.innerHTML = '<span class="st-dot"></span><span>' + msg + '</span>';
        $status.className = "show " + (type || "ok");
        if(_stTmr){ clearTimeout(_stTmr); _stTmr = null; }
        if(dur !== 0){
          _stTmr = setTimeout(function(){
            $status.className = $status.className.replace("show","").trim();
            _stTmr = null;
          }, dur || 4000);
        }
      }

      function setMsg(m)    { if($loadMsg) $loadMsg.textContent = m; }
      function hideOverlay(){ if($overlay) $overlay.style.display = "none"; }
      function getChId()    { return new URLSearchParams(location.search).get("id") || ""; }

      function rawCookie(c){
        return c && c.startsWith("__hdnea__=") ? c.slice(10) : (c || "");
      }
      function withCookie(u, r){
        if(!u || !r) return u;
        if(u.indexOf("__hdnea__") !== -1) return u;
        return u + (u.indexOf("?") !== -1 ? "&" : "?") + "__hdnea__=" + r;
      }

      function isNonEmpty(v){
        return typeof v === "string" && v.trim().length > 0;
      }

      function normalizeKidKey(kid, key){
        if(!isNonEmpty(kid) || !isNonEmpty(key)) return null;
        return {
          kid: kid.trim().toLowerCase(),
          key: key.trim().toLowerCase()
        };
      }

      function buildClearKeys(ch){
        var out = {};

        if(Array.isArray(ch.sportlink) && ch.sportlink.length > 0){
          ch.sportlink.forEach(function(entry){
            if(typeof entry !== "string") return;
            var parts = entry.split(":");
            if(parts.length < 2) return;
            var pair = normalizeKidKey(parts[0], parts[1]);
            if(pair) out[pair.kid] = pair.key;
          });
          if(Object.keys(out).length > 0) return out;
        }

        if(Array.isArray(ch.sonuxs) && ch.sonuxs.length > 0){
          ch.sonuxs.forEach(function(entry){
            if(typeof entry !== "string") return;
            var parts = entry.split(":");
            if(parts.length < 2) return;
            var pair = normalizeKidKey(parts[0], parts[1]);
            if(pair) out[pair.kid] = pair.key;
          });
          if(Object.keys(out).length > 0) return out;
        }

        var single = normalizeKidKey(ch.key_id, ch.key);
        if(single) out[single.kid] = single.key;

        return out;
      }

      function keyModeOf(ch){
        var hasSportlink = Array.isArray(ch.sportlink) && ch.sportlink.length > 0;
        var hasSonuxs    = Array.isArray(ch.sonuxs) && ch.sonuxs.length > 0;
        var hasMulti     = hasSportlink || hasSonuxs;
        var hasSingle    = isNonEmpty(ch.key_id) && isNonEmpty(ch.key);
        if(hasMulti && hasSingle) return "mixed";
        if(hasMulti)              return "multi";
        if(hasSingle)             return "single";
        return "none";
      }

      async function loadData(){
        try {
          var r = await fetch(API, {cache:"no-store", headers:{Accept:"application/json"}});
          if(r.ok) {
            var d = await r.json();
            if(Array.isArray(d) && d.length > 0){
              return { channels: d };
            }
            if(d && Array.isArray(d.channels) && d.channels.length > 0){
              return d;
            }
          }
        } catch(e) {
          console.warn("API failed:", e);
        }
        return { channels: [] };
      }

      /* ═══════════ RENDER LIST WITH SEARCH ═══════════ */
      function renderChannels(channels) {
        $grid.innerHTML = "";
        if (!channels || channels.length === 0) {
          $grid.innerHTML = '<div class="no-results"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg><br>No channels found</div>';
          return;
        }

        var f = document.createDocumentFragment();
        channels.forEach(function(ch){
          var a = document.createElement("a");
          a.className = "ch-card";
          a.href = "?id=" + encodeURIComponent(ch.id);

          var logoUrl = ch.logo || LOGO_MAP[ch.id] || "";
          var initials = (ch.name || "TV").split(" ").slice(0,2).map(function(w){return w[0]||'';}).join('');

          if (isNonEmpty(logoUrl)) {
            var img = document.createElement("img");
            img.className = "ch-logo";
            img.src = logoUrl;
            img.alt = ch.name;
            img.loading = "lazy";
            img.referrerPolicy = "no-referrer";
            img.onerror = function() {
              this.style.display = "none";
              var fallback = document.createElement("div");
              fallback.className = "ch-logo-fallback";
              fallback.textContent = initials;
              if (this.parentNode) {
                this.parentNode.insertBefore(fallback, this);
              }
            };
            a.appendChild(img);
          } else {
            var fallback = document.createElement("div");
            fallback.className = "ch-logo-fallback";
            fallback.textContent = initials;
            a.appendChild(fallback);
          }

          var span = document.createElement("span");
          span.textContent = ch.name;
          a.appendChild(span);
          f.appendChild(a);
        });

        $grid.appendChild(f);
      }

      function filterChannels(query) {
        if (!query || !query.trim()) {
          renderChannels(_allChannels);
          return;
        }
        var q = query.trim().toLowerCase();
        var filtered = _allChannels.filter(function(ch) {
          return (ch.name || "").toLowerCase().includes(q) || (ch.id || "").toLowerCase().includes(q);
        });
        renderChannels(filtered);
      }

      function renderList(channels){
        hideOverlay();
        _allChannels = channels;
        renderChannels(channels);
        $list.style.display = "flex";
      }

      function errMsg(msg){
        setMsg(msg);
        $overlay.style.display = "flex";
        toast(msg, "err", 0);
      }

      function shakaErrStr(e){
        if(!e) return "Playback Error";
        var cat = {1:"Network",2:"Text",3:"Media",4:"Manifest",5:"Stream",6:"DRM",7:"Player"};
        var s = (cat[e.category] || "Error") + " " + e.category + ":" + e.code;
        if(e.data && e.data[0] && typeof e.data[0] === "string")
          s += " — " + e.data[0].slice(0, 72);
        return s;
      }

      function ratioLabel(w, h){
        if(!w || !h) return "—";
        function gcd(a, b){ return b ? gcd(b, a % b) : a; }
        var g = gcd(w, h) || 1, rw = w/g, rh = h/g;
        var named = {
          "16:9":16/9, "4:3":4/3, "21:9":21/9, "1:1":1,
          "9:16":9/16, "3:2":3/2, "5:4":5/4, "2:1":2
        };
        var real = w/h, best = null, bestD = 0.02;
        Object.keys(named).forEach(function(k){
          var d = Math.abs(named[k] - real);
          if(d < bestD){ bestD = d; best = k; }
        });
        if(best) return best;
        if(rw <= 40 && rh <= 40) return rw + ":" + rh;
        return real.toFixed(2) + ":1";
      }

      function injectControls(container, vid){
        var panel = container.querySelector(".shaka-controls-button-panel");
        if(!panel) return false;

        var anchor = panel.querySelector(".shaka-fullscreen-button");
        var fitIdx  = 0;
        var fitBtn  = document.createElement("button");
        fitBtn.className = "sp-btn sp-fit-btn";
        fitBtn.title     = "Video Fit: " + FIT_LABELS.contain;
        fitBtn.setAttribute("aria-label", "Cycle Video Fit Mode");
        fitBtn.innerHTML = '<span class="fit-pill">—</span>';

        if(anchor) panel.insertBefore(fitBtn, anchor);
        else       panel.appendChild(fitBtn);

        var currentRatio = "—";
        function applyFit(i){
          fitIdx = i;
          var m = FITS[i];
          vid.classList.remove("mode-fill","mode-cover");
          if(m === "fill")  vid.classList.add("mode-fill");
          if(m === "cover") vid.classList.add("mode-cover");
          fitBtn.classList.remove("mode-fill","mode-cover");
          if(m !== "contain") fitBtn.classList.add("mode-" + m);
          fitBtn.title = "Video Fit: " + FIT_LABELS[m];
          var pill = fitBtn.querySelector(".fit-pill");
          if(pill) pill.textContent = (m === "contain") ? currentRatio : FIT_LABELS[m];
        }

        fitBtn.addEventListener("click", function(e){
          e.stopPropagation();
          applyFit((fitIdx + 1) % FITS.length);
        });

        ["fullscreenchange","webkitfullscreenchange"].forEach(function(ev){
          document.addEventListener(ev, function(){
            if(!(document.fullscreenElement || document.webkitFullscreenElement)) applyFit(0);
          });
        });

        var _ratioTries = 0;
        function updateRatio(){
          var pill = fitBtn.querySelector(".fit-pill");
          if(!pill) return;
          if(vid.videoWidth > 0){
            currentRatio = ratioLabel(vid.videoWidth, vid.videoHeight);
            if(FITS[fitIdx] === "contain") pill.textContent = currentRatio;
            _ratioTries = 0;
          } else if(_ratioTries < 15){
            _ratioTries++;
            setTimeout(updateRatio, 700);
          }
        }

        vid.addEventListener("loadedmetadata", function(){ _ratioTries = 0; updateRatio(); });
        vid.addEventListener("resize", updateRatio);
        vid.addEventListener("timeupdate", function onFirstFrame(){
          vid.removeEventListener("timeupdate", onFirstFrame);
          updateRatio();
        });
        updateRatio();

        return true;
      }

      async function startPlayer(ch){
        $pc.style.display = "flex";
        shaka.polyfill.installAll();
        if(!shaka.Player.isBrowserSupported()){ errMsg("Browser Not Supported."); return; }

        var player = new shaka.Player();
        await player.attach($vid);

        new shaka.ui.Overlay(player, $pc, $vid).configure({
          controlPanelElements:[
            "play_pause","mute","volume",
            "time_and_duration","spacer",
            "quality","picture_in_picture","fullscreen"
          ],
          seekBarColors:{
            base:    "#828282",
            buffered:"#ffc336",
            played:  "#1fc7ff"
          }
        });

        var _injectCount = 0;
        (function tryInject(){
          if(injectControls($pc, $vid)) return;
          if(++_injectCount < 5) setTimeout(tryInject, 150);
        })();

        var cookie = ch.cookie;
        var raw    = rawCookie(cookie);
        var url    = ch.stream_url;
        var drmKeys = buildClearKeys(ch);
        var keyMode = keyModeOf(ch);

        var restrictionsRelaxed = false;
        var thermalApplied      = false;
        var sessionStart        = Date.now();

        if(Object.keys(drmKeys).length === 0){
          toast("No DRM Keys Available","err",0);
          return;
        }

        var thermalTimer = setInterval(function(){
          if(Date.now() - sessionStart < 60*60*1000) return;
          clearInterval(thermalTimer);
          if(thermalApplied) return;
          thermalApplied = true;
          try{
            player.configure("streaming.bufferBehind", 8);
            if(/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)){
              player.configure("abr.restrictions.maxHeight", Math.min(PROF.maxH, 720));
            }
          }catch(_){}
        }, 60000);

        function buildCfg(){
          var effMaxH = (thermalApplied && /Android|iPhone|iPad|iPod/i.test(navigator.userAgent))
            ? Math.min(PROF.maxH, 720) : PROF.maxH;
          var restr = {};
          if(!restrictionsRelaxed){
            if(effMaxH < 1080) restr.maxHeight    = effMaxH;
            if(PROF.maxBw > 0) restr.maxBandwidth = PROF.maxBw;
          }
          return {
            drm:{ clearKeys: drmKeys },
            manifest:{
              defaultPresentationDelay:4,
              ignoreTextStreamFailures:true,
              retryParameters:{maxAttempts:5,baseDelay:500,backoffFactor:2,fuzzFactor:.5,timeout:30000}
            },
            streaming:{
              lowLatencyMode:false,
              bufferingGoal:PROF.buf,
              rebufferingGoal:PROF.reBuf,
              bufferBehind:PROF.behind,
              safeSeekOffset:4,
              stallEnabled:true,
              stallThreshold:1,
              stallSkip:.3,
              inaccurateManifestTolerance:0,
              retryParameters:{maxAttempts:5,baseDelay:500,backoffFactor:2,fuzzFactor:.5,timeout:30000}
            },
            abr:{
              enabled:true,
              defaultBandwidthEstimate:PROF.bwEst,
              switchInterval:4,
              restrictions:restr
            }
          };
        }

        player.configure(buildCfg());

        var T = shaka.net.NetworkingEngine.RequestType;
        player.getNetworkingEngine().registerRequestFilter(function(type, req){
          req.headers["Referer"]    = "https://www.jiotv.com/";
          req.headers["User-Agent"] = "Mozilla/5.0 (Linux; Android 11; SM-G991B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36";
          req.headers["Cookie"]     = cookie;
          if(type === T.MANIFEST || type === T.SEGMENT)
            req.uris = req.uris.map(function(u){ return withCookie(u, raw); });
        });

        var refreshing = false;
        var retries    = 0;
        var edgeTried  = false;
        var lastTry    = 0;
        var started    = false;
        var stallTmr   = null;

        function unmuteOnce(){ $vid.muted = false; }
        $pc.addEventListener("pointerdown", unmuteOnce, {capture:true,once:true});
        $pc.addEventListener("click",       unmuteOnce, {capture:true,once:true});
        $pc.addEventListener("keydown",     unmuteOnce, {capture:true,once:true});

        function goLiveEdge(){
          if(refreshing) return;
          try{
            player.goToLive();
            edgeTried = true;
            toast("Syncing To Live Edge…","warn",2000);
          }catch(_){ reload(); }
        }

        async function reload(){
          var now = Date.now();
          if(refreshing || now - lastTry < 1500) return;
          if(retries >= 5){ toast("Stream Unavailable. Please Try Again Later.","err",0); return; }
          refreshing = true; lastTry = now; retries++;
          toast("Reconnecting… (" + retries + " / 5)","warn",0);
          try{
            var d     = await loadData();
            var fresh = d.channels.find(function(c){ return c.id === ch.id; });
            if(!fresh) throw new Error("missing");
            var freshKeys = buildClearKeys(fresh);
            if(Object.keys(freshKeys).length === 0) throw new Error("no_keys");
            cookie  = fresh.cookie;
            raw     = rawCookie(cookie);
            drmKeys = freshKeys;
            keyMode = keyModeOf(fresh);
            url     = fresh.stream_url;
            player.configure(buildCfg());
            await player.load(url);
            $vid.play().catch(function(){});
            retries = 0; edgeTried = false;
            toast("Live","live",4000);
          }catch(_){
            setTimeout(reload, Math.min(1000 * Math.pow(2, retries - 1), 8000));
          }finally{ refreshing = false; }
        }

        var RECOVERABLE = [1001,1002,1003,4012,6006,6007,7000,7001,7002];

        player.addEventListener("error", function(ev){
          var err  = ev.detail;
          var code = err && err.code;
          if(code === 4014 && !restrictionsRelaxed){
            restrictionsRelaxed = true;
            refreshing = true;
            player.configure(buildCfg());
            toast("Adjusting Quality…","warn",2000);
            player.load(url)
              .then(function(){ $vid.play().catch(function(){}); toast("Live","live",4000); })
              .catch(function(){ reload(); })
              .finally(function(){ refreshing = false; });
            return;
          }
          if(RECOVERABLE.indexOf(code) !== -1){
            toast("Buffering…","warn",0);
            setTimeout(function(){ if(!refreshing) reload(); }, 700);
          } else {
            toast(shakaErrStr(err),"err",6000);
          }
        });

        try{
          setMsg("Loading Stream…");
          toast("Loading Stream…","warn",0);
          await player.load(url);
          hideOverlay();
          toast("Ready — Tap ▶ To Play","ok",5000);
        }catch(_){
          hideOverlay();
          toast("Connection Error — Retrying…","warn",0);
          setTimeout(reload, 1500);
          return;
        }

        function onStall(){
          if(stallTmr) return;
          toast("Buffering…","warn",0);
          if(!started || refreshing) return;
          stallTmr = setTimeout(function(){
            stallTmr = null;
            if(!edgeTried) goLiveEdge(); else reload();
          }, 5000);
        }

        function onPlaying(){
          started = true;
          if(stallTmr){ clearTimeout(stallTmr); stallTmr = null; }
          edgeTried = false;
          if(!refreshing) toast("Live","live",3000);
        }

        $vid.addEventListener("waiting", onStall);
        $vid.addEventListener("stalled", onStall);
        $vid.addEventListener("playing", onPlaying);
        $vid.addEventListener("error",   function(){
          if(!refreshing){
            toast("Buffering…","warn",0);
            setTimeout(function(){ if(!refreshing) reload(); }, 700);
          }
        });

        document.addEventListener("visibilitychange", function(){
          if(!document.hidden){
            setTimeout(function(){
              if(started && $vid.paused && !refreshing) $vid.play().catch(function(){});
            }, 400);
          }
        });

        var netConn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if(netConn){
          netConn.addEventListener("change", function(){
            if(!player || restrictionsRelaxed) return;
            var t = netConn.effectiveType || "4g";
            var h = t === "slow-2g" || t === "2g" ? 240 : t === "3g" ? 480 : PROF.maxH;
            try{ player.configure("abr.restrictions.maxHeight", h); }catch(_){}
            if(h < PROF.maxH) toast("Slow Network — Reducing Quality","warn",3000);
          });
        }
      }

      async function main(){
        var id = getChId(), data;
        try{
          setMsg("Fetching Channels…");
          data = await loadData();
        }catch(_){
          errMsg("Connection Error. Please Check Your Internet.");
          return;
        }
        if(!id){ renderList(data.channels); return; }
        var ch = data.channels.find(function(c){ return c.id === id; });
        if(!ch){ errMsg("Channel Not Found."); return; }
        document.title = ch.name;
        await startPlayer(ch);
      }

      document.addEventListener("DOMContentLoaded", function() {
        $search.addEventListener("input", function(e) {
          filterChannels(e.target.value);
        });
        main();
      });
    })();
  </script>

  <!-- Telegram Popup Logic -->
  <script>
    (function(){
      var tgOverlay=document.getElementById('tgOverlay');
      function closePopup(){tgOverlay.classList.remove('show');}
      setTimeout(function(){tgOverlay.classList.add('show');},3000);
      document.getElementById('joinNow').onclick=function(){window.open('https://t.me/sportlink10','_blank');closePopup();};
      document.getElementById('joinedBtn').onclick=function(){closePopup();};
