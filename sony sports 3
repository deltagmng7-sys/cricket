    background: rgba(15, 23, 42, 0.95);
  }

  .search-wrapper svg {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    fill: #38bdf8;
    opacity: 0.8;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .search-wrapper input:focus+svg {
    opacity: 1;
  }

  /* ── channel grid ── */
  #ch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
    transition: all 0.2s;
  }

  .ch-card {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.8));
    border: 1px solid rgba(56, 189, 248, 0.12);
    border-radius: 16px;
    padding: 16px 12px 14px;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    -webkit-tap-highlight-color: transparent;
    min-height: 145px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .ch-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 20%, rgba(56, 189, 248, 0.15), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }

  .ch-card:hover::before {
    opacity: 1;
  }

  .ch-card:hover {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(56, 189, 248, 0.15), 0 0 0 1px rgba(56, 189, 248, 0.2);
  }

  .ch-card:active {
    transform: scale(0.96);
    transition: transform 0.08s;
  }

  .ch-card:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 3px;
  }

  .ch-card span {
    color: #e2e8f0;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 36px;
    width: 100%;
    letter-spacing: 0.2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .ch-logo {
    width: 100%;
    max-width: 88px;
    height: 50px;
    object-fit: contain;
    border-radius: 8px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5)) brightness(1.05);
    transition: transform 0.25s;
  }

  .ch-card:hover .ch-logo {
    transform: scale(1.05);
  }

  .ch-logo-fallback {
    width: 88px;
    height: 50px;
    border-radius: 10px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 1.5px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 2px;
    flex-shrink: 0;
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
    box-shadow: inset 0 0 20px rgba(56, 189, 248, 0.05);
  }

  /* ── no results message ── */
  .no-results {
    grid-column: 1/-1;
    text-align: center;
    padding: 48px 20px;
    color: #64748b;
    font-size: 15px;
    font-weight: 500;
    background: rgba(15, 23, 42, 0.5);
    border-radius: 18px;
    border: 1px dashed rgba(56, 189, 248, 0.2);
    backdrop-filter: blur(4px);
  }

  .no-results svg {
    width: 48px;
    height: 48px;
    fill: #38bdf8;
    opacity: 0.4;
    margin-bottom: 12px;
  }

  /* ── player container ── */
  #pc {
    position: fixed;
    inset: 0;
    background: #000;
    display: none;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  video.mode-fill {
    object-fit: fill;
  }

  video.mode-cover {
    object-fit: cover;
  }

  /* ── status toast ── */
  #status {
    position: fixed;
    top: max(14px, env(safe-area-inset-top));
    right: 12%;
    transform: translateY(-10px);
    z-index: 9997;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px 8px 14px;
    background: rgba(10, 15, 26, 0.95);
    border: 1px solid rgba(56, 189, 248, 0.2);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.3px;
    border-radius: 30px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    white-space: nowrap;
    max-width: calc(100vw - 32px);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(56, 189, 248, 0.08);
  }

  #status.show {
    opacity: 1;
    transform: translateY(0);
  }

  .st-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }

  #status.ok {
    color: #b0c4de;
  }
  #status.ok .st-dot {
    background: #60a5fa;
    box-shadow: 0 0 10px #60a5fa;
  }
  #status.live {
    color: #b8e6d9;
  }
  #status.live .st-dot {
    background: #22d3a0;
    animation: dot-pulse 2s ease-in-out infinite;
    box-shadow: 0 0 10px #22d3a0;
  }
  #status.warn {
    color: #fde68a;
  }
  #status.warn .st-dot {
    background: #fb923c;
    animation: dot-pulse 1s ease-in-out infinite;
    box-shadow: 0 0 10px #fb923c;
  }
  #status.err {
    color: #fca5a5;
  }
  #status.err .st-dot {
    background: #f87171;
    box-shadow: 0 0 10px #f87171;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.3;
      transform: scale(0.55);
    }
  }

  /* ── shaka controls overrides ── */
  .sp-btn {
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    padding: 0 10px !important;
    opacity: 0.8;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-width: 38px;
    transition: opacity 0.15s, color 0.15s, transform 0.1s;
    color: #fff !important;
    -webkit-tap-highlight-color: transparent;
  }

  .sp-btn:hover {
    opacity: 1;
    color: #38bdf8 !important;
  }

  .sp-btn:active {
    opacity: 1;
    transform: scale(0.9);
  }

  .sp-btn:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
    border-radius: 8px;
  }

  .sp-btn.active {
    opacity: 1;
    color: #38bdf8 !important;
  }

  .sp-fit-btn {
    padding: 0 8px !important;
    min-width: auto !important;
  }

  .fit-pill {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 8px;
    border-radius: 6px;
    line-height: 1;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
    pointer-events: none;
    white-space: nowrap;
    transition: border-color 0.25s, color 0.25s, background 0.25s;
    background: rgba(0, 0, 0, 0.35);
  }

  .sp-fit-btn:hover .fit-pill {
    border-color: rgba(56, 189, 248, 0.6);
    color: #fff;
  }

  .sp-fit-btn.mode-fill .fit-pill {
    border-color: #38bdf8;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
  }

  .sp-fit-btn.mode-cover .fit-pill {
    border-color: #a78bfa;
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.1);
  }

  .shaka-controls-container button {
    color: #fff !important;
  }

  .shaka-video-container {
    background-color: #000 !important;
  }

  /* ── responsive ── */
  @media (max-width: 480px) {
    #ch-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 10px;
