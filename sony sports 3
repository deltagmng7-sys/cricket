  /* ═══════════ COLORFUL MODERN UI ═══════════ */
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 30%, #0f172a, #020617);
    overflow: hidden;
    font-family: 'Segoe UI', 'Inter', system-ui, Roboto, Helvetica, Arial, sans-serif;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    color: #e2e8f0;
  }

  /* ── overlay loader ── */
  #overlay {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at 30% 40%, #0b1120, #020617);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 20px;
    backdrop-filter: blur(4px);
  }

  #overlay svg {
    animation: spin 1s linear infinite;
    filter: drop-shadow(0 0 12px #38bdf8);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  #overlay p {
    color: #94a3b8;
    font-size: 13px;
    letter-spacing: 1px;
    text-align: center;
    padding: 0 24px;
    font-weight: 500;
    text-shadow: 0 2px 10px rgba(56, 189, 248, 0.3);
    animation: pulse-text 2s infinite;
  }

  @keyframes pulse-text {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  /* ── channel list container ── */
  #channel-list {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at 80% 10%, #0f172a, #020617);
    z-index: 9998;
    display: none;
    flex-direction: column;
    overflow-y: auto;
    padding: max(20px, env(safe-area-inset-top)) 18px max(20px, env(safe-area-inset-bottom)) 18px;
    scrollbar-width: thin;
    scrollbar-color: #38bdf8 #0a0f1a;
  }

  #channel-list::-webkit-scrollbar {
    width: 5px;
  }

  #channel-list::-webkit-scrollbar-track {
    background: #0a0f1a;
  }

  #channel-list::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #38bdf8, #a78bfa);
    border-radius: 10px;
  }

  /* ── header ── */
  #ch-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
    position: relative;
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #38bdf8;
    flex-shrink: 0;
    box-shadow: 0 0 16px #38bdf8, 0 0 32px #38bdf8;
    animation: brand-pulse 2.2s ease-in-out infinite;
  }

  @keyframes brand-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 16px #38bdf8, 0 0 32px #38bdf8;
    }
    50% {
      opacity: 0.6;
      box-shadow: 0 0 28px #a78bfa, 0 0 48px #a78bfa;
    }
  }

  #ch-header h1 {
    color: #f1f5f9;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: linear-gradient(135deg, #e0f2fe, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 30px rgba(56, 189, 248, 0.3);
  }

  /* ── search bar ── */
  .search-wrapper {
    position: relative;
    margin-bottom: 18px;
    width: 100%;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-wrapper input {
    width: 100%;
    padding: 14px 20px 14px 48px;
    background: rgba(15, 23, 42, 0.9);
    border: 2px solid rgba(56, 189, 248, 0.25);
    border-radius: 60px;
    font-size: 15px;
    color: #f1f5f9;
    outline: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 500;
    letter-spacing: 0.3px;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
