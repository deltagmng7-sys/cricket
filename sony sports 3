    .ch-logo,
    .ch-logo-fallback {
      max-width: 70px;
      height: 42px;
    }
    .ch-logo-fallback {
      font-size: 15px;
    }
    .ch-card span {
      font-size: 11px;
      max-height: 30px;
    }
    #ch-header h1 {
      font-size: 16px;
    }
    .search-wrapper input {
      padding: 12px 16px 12px 42px;
      font-size: 14px;
    }
    .search-wrapper svg {
      left: 14px;
      width: 18px;
      height: 18px;
    }
    .fit-pill {
      font-size: 9px;
      padding: 3px 6px;
    }
    .sp-btn {
      padding: 0 6px !important;
    }
    #status {
      right: 8%;
      font-size: 11px;
      padding: 6px 14px 6px 10px;
    }
  }

  @media (max-width: 380px) {
    .fit-pill {
      font-size: 8px;
      padding: 2px 5px;
    }
    .ch-card span {
      font-size: 10px;
    }
  }

